<!--
  Low-memory server config for a small, single-node span store.
  Follows ClickHouse's small-server guidance: drop the internal log tables
  nothing here reads, keep a short-lived query log for debugging, shrink the
  caches, and size the background pools for 2 vCPU.
-->
<clickhouse>
    <!-- Never read by Foglamp. Each one is a table ClickHouse writes and
         merges in the background, all day. -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <text_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <error_log remove="1"/>

    <!-- Kept for debugging slow queries, but only for a week. -->
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 7 DAY</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>

    <!-- Caches: defaults are sized for big servers (5 GB mark cache). -->
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <index_uncompressed_cache_size>16777216</index_uncompressed_cache_size>
    <mmap_cache_size>256</mmap_cache_size>
    <compiled_expression_cache_size>16777216</compiled_expression_cache_size>

    <!-- Leave headroom under the container limit so a heavy query fails
         cleanly instead of the container being OOM-killed. -->
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>

    <!-- Background pools sized for 2 vCPU. -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <background_move_pool_size>2</background_move_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>2</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>2</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>2</background_distributed_schedule_pool_size>

    <merge_tree>
        <!-- With a 4-slot pool these must stay below the pool size, or
             MergeTree tables refuse to start. -->
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>0</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_mutation>0</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>0</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
        <!-- Smaller merge blocks: less memory per running merge. -->
        <merge_max_block_size>1024</merge_max_block_size>
        <!-- A TTL change (RETENTION_DAYS_CAP, reasserted on every boot) only
             recalculates each part's expiry instead of rewriting every row.
             The full rewrite drags the multi-MB input/output payloads through
             memory: on 2026-10-23 it hit the 1.5 GB ceiling, failed, crashed
             ingest's boot and kept retrying. Expired rows are still deleted,
             by the next TTL merge. -->
        <materialize_ttl_recalculate_only>1</materialize_ttl_recalculate_only>
    </merge_tree>
</clickhouse>
